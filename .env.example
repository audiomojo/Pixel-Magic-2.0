# Copy to `.env`: `docker compose` (and so `make up`) reads it. Every line is optional.

# --- Compose (host) variables ---
# Host folder mounted as /data in the workers (one filesystem; check with `make fs-check`).
DATA_DIR=./data
POSTGRES_PASSWORD=pixelmagic
GRAFANA_PORT=3000
# Container user (default 501:20, the first macOS user).
# UID=501
# GID=20
# Memory limit per worker container (e.g. 6g), which also sizes its default CPU_CONCURRENCY.
# Unset: no limit, and each container sizes itself from the whole Docker VM.
# WORKER_MEM_LIMIT=
# WORKER_EXTRA_MEM_LIMIT=

# --- Tunables, forwarded to the workers (spec §11). Unset or empty: the default shown. ---
SCAN_INTERVAL_S=30
STABLE_SECONDS=5
MAX_IN_FLIGHT=5000
IO_CONCURRENCY=8
# CPU_CONCURRENCY defaults to min(CPUs, memory / DECODE_MEM_BUDGET_MB), at least 1
# CPU_CONCURRENCY=
DECODE_MEM_BUDGET_MB=1280
DECODE_TIMEOUT_S=60
POISON_ATTEMPTS=5
LOOK_ALIKE_PHASH=8
LOOK_ALIKE_DHASH=10
COPY_PHASH=4
COPY_DHASH=6
LIVE_MAX_DURATION_S=5
STAGE_MAX_STALENESS_S=900
