DATA_DIR=/data
DATABASE_URL=postgres://pixelmagic:pixelmagic@postgres:5432/pixelmagic
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
WORKER_QUEUES=main,io,cpu,cluster
SCAN_INTERVAL_S=30
STABLE_SECONDS=5
MAX_IN_FLIGHT=5000
IO_CONCURRENCY=8
# CPU_CONCURRENCY defaults to the number of available CPUs
DECODE_TIMEOUT_S=60
POISON_ATTEMPTS=5
LOOK_ALIKE_PHASH=8
LOOK_ALIKE_DHASH=10
COPY_PHASH=4
COPY_DHASH=6
LIVE_MAX_DURATION_S=5
STAGE_MAX_STALENESS_S=900
