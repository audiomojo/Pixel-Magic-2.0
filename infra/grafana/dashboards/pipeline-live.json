    {
      "id": 31,
      "title": "① Scan",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pixelmagic"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pixelmagic"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH r AS (SELECT * FROM harvest_runs WHERE state IN ('scanning','sending','paused') ORDER BY id LIMIT 1),\nf AS (SELECT sum(rf.dirs) AS dirs, sum(rf.photos) AS photos,\n             bool_or(rf.state IN ('queued','scanning')) AS scanning\n      FROM harvest_run_folders rf JOIN r ON rf.run_id = r.id)\nSELECT CASE\n  WHEN r.id IS NULL THEN 'idle'\n  WHEN r.send_only THEN 'skipped (sending approved photos)'\n  WHEN r.state = 'scanning' OR (r.state = 'paused' AND f.scanning) THEN\n    CASE WHEN r.state = 'paused' THEN 'paused (' || coalesce(r.paused_reason, '?') || ')' ELSE 'scanning' END\n    || ' · ' || to_char(f.dirs, 'FM999,999,999,990') || ' folders · ' || to_char(f.photos, 'FM999,999,999,990') || ' photos'\n  ELSE 'done · ' || to_char(f.photos, 'FM999,999,999,990') || ' photos found'\nEND AS value\nFROM (SELECT 1) one LEFT JOIN r ON true LEFT JOIN f ON true"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "n/a",
          "mappings": [
            {
              "type": "regex",
              "options": {
                "pattern": "^(idle|empty|done|skipped)",
                "result": {
                  "color": "#8e8e8e",
                  "index": 0
                }
              }
            },
            {
              "type": "regex",
              "options": {
                "pattern": "^(paused|waiting)",
                "result": {
                  "color": "orange",
                  "index": 1
                }
              }
            },
            {
              "type": "regex",
              "options": {
                "pattern": "^dry run",
                "result": {
                  "color": "blue",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "/^value$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "description": "The active harvest run walking its folders: folders read and photos found so far. Green: working now. Orange: waiting or paused. Grey: idle or finished."
    },
    {
      "id": 32,
      "title": "② Check & copy",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pixelmagic"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 8,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pixelmagic"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH r AS MATERIALIZED (SELECT * FROM harvest_runs WHERE state IN ('scanning','sending','paused') ORDER BY id LIMIT 1),\nf AS MATERIALIZED (SELECT rf.*, hf.source_id, hf.rel_path, lower(hf.rel_path) AS lk FROM harvest_run_folders rf\n      JOIN harvest_folders hf ON hf.id = rf.folder_id JOIN r ON rf.run_id = r.id),\ns AS (SELECT coalesce(sum(sent + known + dups), 0) AS done,\n             bool_or(state IN ('queued','scanning')) AS scanning FROM f),\nl AS (SELECT count(*) AS n FROM harvest_items i, r WHERE i.state = 'PLANNED' AND CASE\n        WHEN r.send_only THEN EXISTS (SELECT 1 FROM harvest_run_items ri\n                                      WHERE ri.run_id = r.id AND ri.item_id = i.id)\n        ELSE EXISTS (SELECT 1 FROM f WHERE f.source_id = i.source_id AND (f.rel_path = ''\n          OR (i.rel_path COLLATE \"C\" >= f.rel_path || '/' AND i.rel_path COLLATE \"C\" < f.rel_path || '0')\n          OR (i.path_key COLLATE \"C\" >= f.lk || '/'\n              AND i.path_key COLLATE \"C\" < f.lk || '0')))\n      END),\nw AS (SELECT count(*) AS n, min(decided_at) AS since,\n             count(*) FILTER (WHERE decided_at > now() - interval '2 minutes') AS recent\n      FROM harvest_items\n      WHERE decided_at > now() - interval '10 minutes' AND state IN ('SENT','KNOWN','DUP')),\nk AS (SELECT w.recent, l.n AS left_n, s.done, s.scanning OR r.state = 'scanning' AS scanning,\n             CASE WHEN w.n = 0 THEN 0\n                  ELSE w.n / greatest(extract(epoch FROM now() - w.since) / 60, 1) END AS per_min\n      FROM r, s, l, w)\nSELECT CASE\n  WHEN r.id IS NULL THEN 'idle'\n  WHEN r.dry_run THEN 'dry run (nothing is copied)'\n  WHEN r.state = 'paused' THEN 'paused (' || coalesce(r.paused_reason, '?') || ') · '\n    || to_char(k.left_n, 'FM999,999,999,990') || ' left'\n  WHEN k.recent = 0 AND k.left_n = 0 AND k.scanning THEN 'waiting for the scan to find photos'\n  WHEN k.recent = 0 THEN 'waiting · ' || to_char(k.left_n, 'FM999,999,999,990') || ' left'\n  WHEN k.scanning THEN 'working while scanning · ' || to_char(k.left_n, 'FM999,999,999,990') || ' left so far · '\n    || to_char(round(k.per_min), 'FM999,999,999,990') || '/min'\n  ELSE 'working · ' || floor(100.0 * k.done / greatest(k.done + k.left_n, 1)) || '% · '\n    || to_char(k.left_n, 'FM999,999,999,990') || ' left · ' || to_char(round(k.per_min), 'FM999,999,999,990') || '/min · ~'\n    || CASE WHEN ceil(k.left_n / k.per_min)::int >= 1440 THEN (ceil(k.left_n / k.per_min)::int / 1440) || 'd ' || (ceil(k.left_n / k.per_min)::int % 1440 / 60) || 'h' WHEN ceil(k.left_n / k.per_min)::int >= 60 THEN (ceil(k.left_n / k.per_min)::int / 60) || 'h ' || (ceil(k.left_n / k.per_min)::int % 60) || 'm' ELSE ceil(k.left_n / k.per_min)::int || 'm' END\nEND AS value\nFROM (SELECT 1) one LEFT JOIN r ON true LEFT JOIN k ON true"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "n/a",
          "mappings": [
            {
              "type": "regex",
              "options": {
                "pattern": "^(idle|empty|done|skipped)",
                "result": {
                  "color": "#8e8e8e",
                  "index": 0
                }
              }
            },
            {
              "type": "regex",
              "options": {
                "pattern": "^(paused|waiting)",
                "result": {
                  "color": "orange",
                  "index": 1
                }
              }
            },
            {
              "type": "regex",
              "options": {
                "pattern": "^dry run",
                "result": {
                  "color": "blue",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "/^value$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "description": "The harvester checking each photo found against the vault and copying the new ones to the drop zone: % of the run checked, photos left, photos checked per minute (last 10 min) and the time left at that rate. Photos already in the vault are checked but not copied, so this step can be busy while the drop zone stays empty. Green: working now. Orange: waiting or paused. Grey: idle or finished."
    },
