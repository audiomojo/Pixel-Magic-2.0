    {
      "id": 23,
      "title": "Harvest run",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pixelmagic"
      },
      "gridPos": {
        "x": 9,
        "y": 26,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pixelmagic"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce((SELECT state || coalesce(' (' || paused_reason || ')', '') FROM harvest_runs WHERE state IN ('scanning','sending','paused') ORDER BY id LIMIT 1), 'idle') AS value"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "n/a"
        },
