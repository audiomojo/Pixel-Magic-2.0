{
  "uid": "pixel-magic-live",
  "title": "Pixel Magic: Pipeline Live",
  "tags": ["pixel-magic"],
  "timezone": "browser",
  "refresh": "5s",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Drop zone",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pixelmagic"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pixelmagic"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT pending_files, pending_bytes FROM scan_stats WHERE id = 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "n/a"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "pending_bytes"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "description": "Files and bytes waiting in the drop zone (last scan)."
    },
    {
      "id": 2,
      "title": "In flight",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "temporal_visibility"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "temporal_visibility"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS value FROM executions_visibility WHERE workflow_type_name = 'FileWorkflow' AND status = 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "n/a"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "/^value$/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": "Running FileWorkflows (Temporal visibility)."
    },
    {
      "id": 3,
      "title": "ETA",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pixelmagic"
      },
      "gridPos": {
        "x": 7,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pixelmagic"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH b AS (SELECT count(*) AS n FROM contents WHERE kind = 'still' AND state IN ('INGESTED','HASHED')),\nr AS (SELECT count(*)::float8 / 600 AS per_s FROM contents WHERE clustered_at > now() - interval '10 minutes')\nSELECT CASE WHEN b.n = 0 THEN 0::float8 WHEN r.per_s = 0 THEN NULL ELSE b.n / r.per_s END AS value FROM b, r"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "n/a",
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "/^value$/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": "Backlog divided by the clustering rate over the last 10 minutes."
    },
    {
      "id": 4,
      "title": "Copy groups",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pixelmagic"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pixelmagic"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS value FROM (SELECT copy_group_id FROM contents WHERE copy_group_id IS NOT NULL GROUP BY copy_group_id HAVING count(*) >= 2) AS g"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "n/a"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "/^value$/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": "Copy groups with two or more different files of the same shot (for example a HEIC and its resized JPG): the folders under staging/current/copies/. Photos with no other version are not counted."
    },
    {
      "id": 5,
      "title": "Similar groups",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pixelmagic"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pixelmagic"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS value FROM (SELECT similar_set_id FROM groups WHERE kind = 'copy' AND merged_into IS NULL AND similar_set_id IS NOT NULL GROUP BY similar_set_id HAVING count(*) >= 2) AS sets"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "n/a"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "/^value$/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": "Similar groups: look-alike sets (bursts, several takes of one scene) of two or more copy groups, all kept: the folders under staging/current/similar/."
    },
    {
      "id": 6,
      "title": "Duplicates removed",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pixelmagic"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pixelmagic"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE copy_removed_at IS NOT NULL) AS removed,\n  coalesce(sum(copy_reclaimed_bytes), 0)::bigint AS reclaimed_bytes,\n  coalesce(sum(size_bytes) FILTER (WHERE copy_removed_at IS NULL AND NOT copy_mismatch), 0)::bigint AS pending_bytes\nFROM files WHERE state = 'COPY'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "n/a"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "reclaimed_bytes"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "pending_bytes"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "description": "Byte-identical duplicate drops whose vault/.copies file was removed after a fresh re-hash of it and its vault file matched: how many, the bytes reclaimed, and the bytes of duplicates still waiting for removal (the sweep runs every 15 min)."
    },
    {
      "id": 13,
      "title": "Copy mismatches",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pixelmagic"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pixelmagic"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS value FROM files WHERE copy_mismatch"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "n/a",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "/^value$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "description": "Duplicates NOT removed: a re-hash disagreed with files.sha256, or a file was missing. Both files are kept; the observed hashes are in the row's last_error (Recent errors, make doctor). Should read 0."
    },
    {
      "id": 7,
      "title": "Failed",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pixelmagic"
      },
      "gridPos": {
