{
  "uid": "pixel-magic-live",
  "title": "Pixel Magic: Pipeline Live",
  "tags": ["pixel-magic"],
  "timezone": "browser",
  "refresh": "5s",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Drop zone",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pixelmagic"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pixelmagic"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT pending_files, pending_bytes FROM scan_stats WHERE id = 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "n/a"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "pending_bytes"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "description": "Files and bytes waiting in the drop zone (last scan)."
    },
    {
      "id": 2,
      "title": "In flight",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "temporal_visibility"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "temporal_visibility"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS value FROM executions_visibility WHERE workflow_type_name = 'FileWorkflow' AND status = 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "n/a"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "/^value$/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": "Running FileWorkflows (Temporal visibility)."
    },
    {
      "id": 3,
      "title": "ETA",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pixelmagic"
      },
      "gridPos": {
        "x": 7,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pixelmagic"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH b AS (SELECT count(*) AS n FROM contents WHERE kind = 'still' AND state IN ('INGESTED','HASHED')),\nr AS (SELECT count(*)::float8 / 600 AS per_s FROM contents WHERE clustered_at > now() - interval '10 minutes')\nSELECT CASE WHEN b.n = 0 THEN 0::float8 WHEN r.per_s = 0 THEN NULL ELSE b.n / r.per_s END AS value FROM b, r"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "n/a",
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "/^value$/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": "Backlog divided by the clustering rate over the last 10 minutes."
    },
    {
      "id": 4,
      "title": "Copy groups",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pixelmagic"
      },
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pixelmagic"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS value FROM groups WHERE kind = 'copy' AND merged_into IS NULL"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "n/a"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "/^value$/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "Similar sets",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pixelmagic"
      },
      "gridPos": {
        "x": 13,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pixelmagic"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS value FROM groups WHERE kind = 'similar' AND merged_into IS NULL"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "n/a"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "/^value$/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 6,
      "title": "≈ Reclaimable",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pixelmagic"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pixelmagic"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (\n  coalesce((SELECT sum(g.total - g.largest) FROM (\n     SELECT sum(c.size_bytes) AS total, max(c.size_bytes) AS largest\n     FROM contents c JOIN groups gr ON gr.id = c.copy_group_id\n     WHERE gr.kind = 'copy' AND gr.merged_into IS NULL GROUP BY c.copy_group_id) g), 0)\n  + coalesce((SELECT sum(size_bytes) FROM files WHERE state = 'COPY'), 0)\n)::bigint AS value"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "n/a",
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "/^value$/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": "Approximate: per copy group, sum of sizes minus the largest, plus byte-copy files. Does not repeat the best-copy ranking."
    },
    {
      "id": 7,
      "title": "Failed",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pixelmagic"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 2,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pixelmagic"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS value FROM contents WHERE state = 'FAILED'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "/^value$/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 8,
      "title": "Last staging build",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pixelmagic"
      },
      "gridPos": {
        "x": 22,
        "y": 0,
        "w": 2,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pixelmagic"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT extract(epoch FROM now() - max(built_at)) AS value FROM staging_builds"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "n/a",
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "/^value$/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": "Age of the last staging build."
    },
    {
      "id": 9,
      "title": "Backlog by stage",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pixelmagic"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pixelmagic"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT stage AS metric, n AS value FROM (\n  SELECT 'ingest' AS stage, 1 AS ord, count(*) AS n FROM files WHERE state IN ('DISCOVERED','CLAIMED')\n  UNION ALL SELECT 'decode', 2, count(*) FROM contents WHERE kind = 'still' AND state = 'INGESTED'\n  UNION ALL SELECT 'cluster', 3, count(*) FROM contents WHERE kind = 'still' AND state = 'HASHED'\n) s ORDER BY ord"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "n/a"
        },
        "overrides": []
      },
      "options": {
        "xField": "metric",
        "orientation": "horizontal",
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 10,
      "title": "Throughput / min",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pixelmagic"
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pixelmagic"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('minute', ts) AS time, stage AS metric, count(*) AS value FROM (\n  SELECT ingested_at AS ts, 'ingested' AS stage FROM contents\n  UNION ALL SELECT hashed_at, 'hashed' FROM contents\n  UNION ALL SELECT clustered_at, 'clustered' FROM contents\n) s WHERE ts > now() - interval '30 minutes' GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "n/a"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "Quarantined by reason",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pixelmagic"
      },
      "gridPos": {
        "x": 18,
        "y": 4,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pixelmagic"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(quarantine_reason, 'unknown') AS metric, count(*) AS value\nFROM contents WHERE state = 'QUARANTINED' GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "n/a"
        },
        "overrides": []
      },
      "options": {
        "xField": "metric",
        "orientation": "horizontal",
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 12,
      "title": "Recent errors",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pixelmagic"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pixelmagic"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT time, source, id, error FROM (\n  SELECT updated_at AS time, 'content' AS source, left(sha256, 12) AS id, last_error AS error FROM contents WHERE last_error IS NOT NULL\n  UNION ALL SELECT updated_at, 'file', id::text, last_error FROM files WHERE last_error IS NOT NULL\n) e ORDER BY time DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "n/a"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
