          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH b AS (SELECT count(*) AS n FROM files WHERE state IN ('DISCOVERED','CLAIMED')),\nd AS (SELECT count(*) FILTER (WHERE ts > now() - interval '5 minutes') AS n5,\n             count(*) FILTER (WHERE ts > now() - interval '2 minutes') AS n2 FROM (SELECT updated_at AS ts FROM files WHERE state NOT IN ('DISCOVERED','CLAIMED')) t)\nSELECT CASE\n  WHEN d.n2 > 0 THEN 'working · ' || to_char(b.n, 'FM999,999,999,990') || ' waiting · ' || to_char(ceil(d.n5 / 5.0), 'FM999,999,999,990') || '/min'\n  WHEN b.n > 0 THEN 'waiting · ' || to_char(b.n, 'FM999,999,999,990') || ' queued'\n  ELSE 'idle'\nEND AS value FROM b, d"
