      },
      "description": "The active harvest run's state, plus the reason when it is paused (disk, backlog, stalled, source unplugged). idle: no run is active."
    },
    {
      "id": 24,
      "title": "Harvester heartbeat",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pixelmagic"
      },
      "gridPos": {
        "x": 14,
        "y": 26,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pixelmagic"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN EXISTS (SELECT 1 FROM harvest_runs WHERE state IN ('scanning','sending','paused')) THEN coalesce(extract(epoch FROM now() - h.heartbeat_at), 999999)::bigint ELSE 0 END AS value FROM (SELECT 1) one LEFT JOIN harvest_host_state h ON h.id = 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "n/a",
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
